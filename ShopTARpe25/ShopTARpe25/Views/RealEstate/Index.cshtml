@model IEnumerable<ShopTARpe25.Models.Realestate.RealEstateIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="RealEstate" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Real estate
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Area</th>
                <th scope="col">Address</th>
                <th scope="col">Roomnumber</th>
                <th scope="col">Building type</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@spaceship.Area</td>
                        <td>@spaceship.Address</td>
                        <td>@spaceship.RoomNumber</td>
                        <td>@spaceship.BuildingType</td>
                        <td>
                            <a asp-action="details" asp-controller="RealEstate" asp-route-id="@spaceship.Id" type="submit" class="btn btn-info">Details</a>
                            <a asp-action="update" asp-controller="RealEstate" asp-route-id="@spaceship.Id" type="submit" class="btn btn-success">Update</a>
                            <a asp-action="delete" asp-controller="RealEstate" asp-route-id="@spaceship.Id" type="submit" class="btn btn-danger">Delete</a>

                        </td>
                    </tr>
                    rowNumber++;
                }
        </tbody>
    </table>
</form>